# Database — Supabase Postgres in production. Leave unset to fall back to a
# local SQLite file (./hackspire.db) so the app runs with no external service.
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# Bootstrap admin (created on startup if no admin account exists)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin
ADMIN_NAME=Admin
ADMIN_STUDENT_STAFF_ID=ADMIN-001

# Local file storage for materials (swappable for Supabase Storage later)
UPLOAD_DIR=./uploads

# Registration cap reported by GET /admin/participants
PARTICIPANT_CAP=150

# Brevo Transactional API key (Brevo -> SMTP & API -> API Keys), distinct
# from the SMTP key used in Supabase's own SMTP settings.
SMTP_API=
# Set to true to send invite emails via Brevo's Transactional API (using
# SMTP_API + the template id below) instead of Supabase's own
# SMTP-triggered mailer. Leave false to keep the default behavior.
USE_BREVO_TRANSACTIONAL_EMAIL=false
# Numeric template ID from Brevo -> Transactional -> Templates (the invite
# template) — leave commented out until you have it (an empty value fails
# to parse as a number).
# BREVO_INVITE_TEMPLATE_ID=123
