# Database — Supabase Postgres in production. Leave unset to fall back to a
# local SQLite file (./hackspire.db) so the app runs with no external service.
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MIN=1440

# Bootstrap admin (created on startup if no admin account exists)
ADMIN_EMAIL=admin@hackspire.dev
ADMIN_PASSWORD=admin123
ADMIN_NAME=HACKSPIRE Admin
ADMIN_STUDENT_STAFF_ID=ADMIN-001

# Local file storage for materials (swappable for Supabase Storage later)
UPLOAD_DIR=./uploads

# Registration cap reported by GET /admin/participants
PARTICIPANT_CAP=150
